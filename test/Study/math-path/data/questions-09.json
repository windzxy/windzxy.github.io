[{"id":"cnc_p432_q2","topicId":"cnc_p432","difficulty":"basic","type":"choice","prompt":"腊八粥是怎样的？","choices":[{"key":"A","text":"和清水一样稀"},{"key":"B","text":"是咸的菜粥"},{"key":"C","text":"稠，甜，里面有米和枣、栗子一类的果料"},{"key":"D","text":"只有一粒米"}],"answer":"C","explanation":"课文把粥写得甜、浓，果料在里面。","verify":"\"稠，甜，里面有米和枣、栗子一类的果料\""},{"id":"cnc_p432_q3","topicId":"cnc_p432","difficulty":"standard","type":"choice","prompt":"八儿为什么等得着急？","choices":[{"key":"A","text":"粥已经吃完了"},{"key":"B","text":"妈妈不许他知道腊八"},{"key":"C","text":"他把锅打翻了"},{"key":"D","text":"粥要到夜里才能吃，他从白天就盼着"}],"answer":"D","explanation":"越是不能马上喝到，越写出他的嘴馋和盼望。","verify":"\"粥要到夜里才能吃，他从白天就盼着\""},{"id":"cnc_p432_q4","topicId":"cnc_p432","difficulty":"standard","type":"choice","prompt":"这篇课文和《北京的春节》都写到腊八粥，差别是什么？","choices":[{"key":"A","text":"这篇紧盯着一个孩子怎样盼，那篇是按日子写全城的习俗"},{"key":"B","text":"两篇是同一个故事"},{"key":"C","text":"这篇没有写粥"},{"key":"D","text":"那篇只写元宵，没有腊八"}],"answer":"A","explanation":"老舍按时间写了整个春节。《腊八粥》把八儿等粥的心情写得很细。","verify":"\"这篇紧盯着一个孩子怎样盼，那篇是按日子写全城的习俗\""},{"id":"cnc_p433_q1","topicId":"cnc_p433","difficulty":"basic","type":"choice","prompt":"「停泊」的「泊」读哪一个？","choices":[{"key":"A","text":"pō"},{"key":"B","text":"bò"},{"key":"C","text":"bó"},{"key":"D","text":"pò"}],"answer":"C","explanation":"停泊、漂泊读 bó。湖泊、血泊才读 pō。","verify":"\"bó\""},{"id":"cnc_p433_q2","topicId":"cnc_p433","difficulty":"basic","type":"choice","prompt":"「漂流」的「漂」读哪一个？","choices":[{"key":"A","text":"piào"},{"key":"B","text":"piǎo"},{"key":"C","text":"biāo"},{"key":"D","text":"piāo"}],"answer":"D","explanation":"漂流、漂浮读 piāo。漂亮才读 piào。","verify":"\"piāo\""},{"id":"cnc_p433_q3","topicId":"cnc_p433","difficulty":"standard","type":"choice","prompt":"「记载」的「载」读哪一个？","choices":[{"key":"A","text":"zǎi"},{"key":"B","text":"zài"},{"key":"C","text":"zāi"},{"key":"D","text":"cái"}],"answer":"A","explanation":"记载、登载读 zǎi。载重、装载才读 zài。","verify":"\"zǎi\""},{"id":"cnc_p433_q4","topicId":"cnc_p433","difficulty":"standard","type":"choice","prompt":"「灾难」的「难」读哪一个？","choices":[{"key":"A","text":"nán"},{"key":"B","text":"nàn"},{"key":"C","text":"nǎn"},{"key":"D","text":"nuó"}],"answer":"B","explanation":"灾难、难民读 nàn。困难、难题才读 nán。","verify":"\"nàn\""},{"id":"cnc_p434_q1","topicId":"cnc_p434","difficulty":"basic","type":"choice","prompt":"「这道题有意思」里的「意思」是什么？","choices":[{"key":"A","text":"有意见"},{"key":"B","text":"有礼物"},{"key":"C","text":"有别的含义要解释"},{"key":"D","text":"有趣味"}],"answer":"D","explanation":"说题目有意思，是说它有趣味，不是要送礼。","verify":"\"有趣味\""},{"id":"cnc_p434_q2","topicId":"cnc_p434","difficulty":"basic","type":"choice","prompt":"「他一点意思也没有」如果是在抱怨礼物，这里的「意思」更接近什么？","choices":[{"key":"A","text":"心意或礼物"},{"key":"B","text":"题目的趣味"},{"key":"C","text":"文字的解释"},{"key":"D","text":"意见簿"}],"answer":"A","explanation":"同样是意思，在送礼的场合可以指心意。","verify":"\"心意或礼物\""},{"id":"cnc_p434_q3","topicId":"cnc_p434","difficulty":"standard","type":"choice","prompt":"「走」在「走棋」里是什么意思？","choices":[{"key":"A","text":"用脚走路"},{"key":"B","text":"移动棋子"},{"key":"C","text":"离开家乡"},{"key":"D","text":"把字写走样"}],"answer":"B","explanation":"走棋是下棋时移动棋子，不是用脚走。","verify":"\"移动棋子\""},{"id":"cnc_p434_q4","topicId":"cnc_p434","difficulty":"standard","type":"choice","prompt":"判断语境义，第一步应该做什么？","choices":[{"key":"A","text":"永远选词典的第一个解释"},{"key":"B","text":"先把词删掉"},{"key":"C","text":"把词放回句子里看"},{"key":"D","text":"换成同音字"}],"answer":"C","explanation":"离开句子，同一个词可以有好几种意思。","verify":"\"把词放回句子里看\""},{"id":"cnc_p435_q1","topicId":"cnc_p435","difficulty":"basic","type":"choice","prompt":"《鲁滨逊漂流记》的作者是谁？","choices":[{"key":"A","text":"笛福"},{"key":"B","text":"马克·吐温"},{"key":"C","text":"托尔斯泰"},{"key":"D","text":"老舍"}],"answer":"A","explanation":"作者是英国作家笛福。马克·吐温写的是汤姆·索亚。","verify":"\"笛福\""},{"id":"cnc_p435_q2","topicId":"cnc_p435","difficulty":"basic","type":"choice","prompt":"流落荒岛以后，他先做了什么来稳住自己？","choices":[{"key":"A","text":"马上造一艘大船回乡"},{"key":"B","text":"把坏处和好处一条条对照着写"},{"key":"C","text":"每天什么也不做"},{"key":"D","text":"把日历扔掉"}],"answer":"B","explanation":"没有同伴是坏处，可是没有人来伤害他也可以看成好处。他用这个办法使自己平静。","verify":"\"把坏处和好处一条条对照着写\""},{"id":"cnc_p435_q3","topicId":"cnc_p435","difficulty":"standard","type":"choice","prompt":"他在岛上怎样生活？","choices":[{"key":"A","text":"只在沙滩上睡觉"},{"key":"B","text":"第二天就被船接走了"},{"key":"C","text":"建住所，种粮食，养羊，还救了星期五"},{"key":"D","text":"和一群水手一起开商店"}],"answer":"C","explanation":"梗概写他在岛上生活了许多年，后来救下被称作星期五的人。","verify":"\"建住所，种粮食，养羊，还救了星期五\""},{"id":"cnc_p435_q4","topicId":"cnc_p435","difficulty":"standard","type":"choice","prompt":"课文的精彩片段主要表现他怎样？","choices":[{"key":"A","text":"后悔出门，从此不再劳动"},{"key":"B","text":"只等待别人来救"},{"key":"C","text":"把荒岛全部烧掉"},{"key":"D","text":"遇到困境仍然想办法活下去"}],"answer":"D","explanation":"造工具、找食物、写下来鼓励自己，都是在主动求生。","verify":"\"遇到困境仍然想办法活下去\""},{"id":"cnc_p436_q1","topicId":"cnc_p436","difficulty":"basic","type":"choice","prompt":"《骑鹅旅行记》的作者是谁？","choices":[{"key":"A","text":"笛福"},{"key":"B","text":"拉格洛芙"},{"key":"C","text":"马克·吐温"},{"key":"D","text":"安徒生"}],"answer":"B","explanation":"作者是瑞典的拉格洛芙。笛福写的是鲁滨逊，不要记混。","verify":"\"拉格洛芙\""},{"id":"cnc_p436_q2","topicId":"cnc_p436","difficulty":"basic","type":"choice","prompt":"尼尔斯为什么被变成了小人？","choices":[{"key":"A","text":"他主动要求变小"},{"key":"B","text":"鹅把他变小了"},{"key":"C","text":"他不爱学习，还捉弄小动物，小狐仙惩罚了他"},{"key":"D","text":"他在梦里变成了小人，醒来就恢复了"}],"answer":"C","explanation":"变小是惩罚。他起初又害怕又着急。","verify":"\"他不爱学习，还捉弄小动物，小狐仙惩罚了他\""},{"id":"cnc_p436_q3","topicId":"cnc_p436","difficulty":"standard","type":"choice","prompt":"他是怎样旅行的？","choices":[{"key":"A","text":"坐火车周游"},{"key":"B","text":"骑着一匹马"},{"key":"C","text":"跟着鲁滨逊出海"},{"key":"D","text":"骑在鹅背上，飞过许多地方"}],"answer":"D","explanation":"雄鹅把他带走。他因此看见了野外的动物和大地。","verify":"\"骑在鹅背上，飞过许多地方\""},{"id":"cnc_p436_q4","topicId":"cnc_p436","difficulty":"standard","type":"choice","prompt":"他后来为什么能变回来？","choices":[{"key":"A","text":"他在旅行中变得善良、敢于承担"},{"key":"B","text":"他把鹅卖掉了"},{"key":"C","text":"小狐仙忘记了这件事"},{"key":"D","text":"旅行一开始他就变回来了"}],"answer":"A","explanation":"梗概的结尾是：他保护了鹅群，也懂得了待人，小狐仙才让他恢复原形。","verify":"\"他在旅行中变得善良、敢于承担\""},{"id":"cnc_p437_q1","topicId":"cnc_p437","difficulty":"basic","type":"choice","prompt":"话没有说完，该用哪一个？","choices":[{"key":"A","text":"破折号"},{"key":"B","text":"书名号"},{"key":"C","text":"省略号"},{"key":"D","text":"间隔号"}],"answer":"C","explanation":"话断了、后面还有没说出的内容，用省略号。","verify":"\"省略号\""},{"id":"cnc_p437_q2","topicId":"cnc_p437","difficulty":"basic","type":"choice","prompt":"「这是我们的班长——李青。」横线处的破折号表示什么？","choices":[{"key":"A","text":"话被打断"},{"key":"B","text":"声音延长"},{"key":"C","text":"列举结束"},{"key":"D","text":"解释说明"}],"answer":"D","explanation":"破折号后面说明班长是谁。","verify":"\"解释说明\""},{"id":"cnc_p437_q3","topicId":"cnc_p437","difficulty":"standard","type":"choice","prompt":"「书架上有童话、故事、诗歌……」这里的省略号表示什么？","choices":[{"key":"A","text":"还有别的书，没有一一列出"},{"key":"B","text":"书架是空的"},{"key":"C","text":"这些书都不见了"},{"key":"D","text":"后面要解释诗歌是什么"}],"answer":"A","explanation":"列举没有写完，用省略号。解释某一个词才常用破折号。","verify":"\"还有别的书，没有一一列出\""},{"id":"cnc_p437_q4","topicId":"cnc_p437","difficulty":"standard","type":"choice","prompt":"声音拉得很长，哪一种标点是对的？","choices":[{"key":"A","text":"喂……（省略号）"},{"key":"B","text":"喂——（破折号）"},{"key":"C","text":"喂。（句号）"},{"key":"D","text":"喂、（顿号）"}],"answer":"B","explanation":"声音拖长用破折号。省略号表示还有内容没说完，不是声音拉长。","verify":"\"喂——（破折号）\""},{"id":"cnc_p438_q1","topicId":"cnc_p438","difficulty":"basic","type":"choice","prompt":"洗手的时候，日子从哪里过去？","choices":[{"key":"A","text":"从窗户里过去"},{"key":"B","text":"从书包里过去"},{"key":"C","text":"从门缝里过去"},{"key":"D","text":"从水盆里过去"}],"answer":"D","explanation":"作者说洗手时，日子从水盆里过去。","verify":"\"从水盆里过去\""},{"id":"cnc_p438_q2","topicId":"cnc_p438","difficulty":"basic","type":"choice","prompt":"吃饭的时候，日子从哪里过去？","choices":[{"key":"A","text":"从饭碗里过去"},{"key":"B","text":"从筷子里过去"},{"key":"C","text":"从厨房的烟囱里过去"},{"key":"D","text":"从水盆里过去"}],"answer":"A","explanation":"吃饭时，日子从饭碗里过去。水盆是洗手的时候。","verify":"\"从饭碗里过去\""},{"id":"cnc_p438_q3","topicId":"cnc_p438","difficulty":"standard","type":"choice","prompt":"燕子、杨柳、桃花和日子有什么不同？","choices":[{"key":"A","text":"它们和时间一样，明年都不会再来"},{"key":"B","text":"它们可以再来，日子却一去不复返"},{"key":"C","text":"日子可以像燕子一样飞回来"},{"key":"D","text":"作者觉得时间并不要紧"}],"answer":"B","explanation":"燕子去了有再来的时候。日子丢了，就没有再回来的时候。","verify":"\"它们可以再来，日子却一去不复返\""},{"id":"cnc_p438_q4","topicId":"cnc_p438","difficulty":"standard","type":"choice","prompt":"作者这样写，是为了说明什么？","choices":[{"key":"A","text":"洗手和吃饭浪费了时间，所以不要做"},{"key":"B","text":"日子可以装进盆里保存"},{"key":"C","text":"时间在平常的事情里悄悄过去，要珍惜"},{"key":"D","text":"时间只要记住就能留下来"}],"answer":"C","explanation":"八千多个日子在无声中溜走。他问自己：留下了些什么？","verify":"\"时间在平常的事情里悄悄过去，要珍惜\""},{"id":"cnc_p439_q1","topicId":"cnc_p439","difficulty":"basic","type":"choice","prompt":"《那个星期天》的作者是谁？","choices":[{"key":"A","text":"史铁生"},{"key":"B","text":"朱自清"},{"key":"C","text":"老舍"},{"key":"D","text":"鲁迅"}],"answer":"A","explanation":"这篇是史铁生写的。朱自清写的是《匆匆》。","verify":"\"史铁生\""},{"id":"cnc_p439_q2","topicId":"cnc_p439","difficulty":"basic","type":"choice","prompt":"「我」从早晨就开始盼望什么？","choices":[{"key":"A","text":"父亲回来修船"},{"key":"B","text":"母亲带「我」出去玩"},{"key":"C","text":"老师来家访"},{"key":"D","text":"雨停下来就可以写作业"}],"answer":"B","explanation":"母亲答应了这个星期天出去。「我」一直等着。","verify":"\"母亲带「我」出去玩\""},{"id":"cnc_p439_q3","topicId":"cnc_p439","difficulty":"standard","type":"choice","prompt":"母亲为什么迟迟没有出门？","choices":[{"key":"A","text":"她忘记了这个约定"},{"key":"B","text":"外面在下大雪"},{"key":"C","text":"家里的活一件接一件，她脱不开身"},{"key":"D","text":"「我」自己改了主意"}],"answer":"C","explanation":"买菜、做饭、洗衣，母亲一直忙。「我」的盼望一点点沉下去。","verify":"\"家里的活一件接一件，她脱不开身\""},{"id":"cnc_p439_q4","topicId":"cnc_p439","difficulty":"standard","type":"choice","prompt":"等到下午，「我」的心情变成了什么？","choices":[{"key":"A","text":"越来越兴奋"},{"key":"B","text":"决定自己先走，把母亲留下"},{"key":"C","text":"完全忘记了原来的约定"},{"key":"D","text":"从盼望变成失望"}],"answer":"D","explanation":"光线暗了，约定还没有实现。那种空落落的失望是课文后半的重心。","verify":"\"从盼望变成失望\""},{"id":"cnc_p440_q1","topicId":"cnc_p440","difficulty":"basic","type":"choice","prompt":"一个孩子说，太阳刚出来时大得像什么？","choices":[{"key":"A","text":"盘盂"},{"key":"B","text":"车盖"},{"key":"C","text":"磨盘"},{"key":"D","text":"铜镜"}],"answer":"B","explanation":"日初出大如车盖。到了中午，他才说像盘盂。","verify":"\"车盖\""},{"id":"cnc_p440_q2","topicId":"cnc_p440","difficulty":"basic","type":"choice","prompt":"另一个孩子说，中午的太阳热得像什么？","choices":[{"key":"A","text":"探火"},{"key":"B","text":"摸冰块"},{"key":"C","text":"把手伸进热水"},{"key":"D","text":"站在风里"}],"answer":"C","explanation":"如探汤，就是像把手伸进热水里。","verify":"\"把手伸进热水\""},{"id":"cnc_p440_q3","topicId":"cnc_p440","difficulty":"standard","type":"choice","prompt":"孔子听完以后怎样？","choices":[{"key":"A","text":"说早上近的那个对"},{"key":"B","text":"说中午近的那个对"},{"key":"C","text":"把两个孩子都批评了一顿"},{"key":"D","text":"不能判断谁对"}],"answer":"D","explanation":"孔子不能决。他没有判定谁赢。","verify":"\"不能判断谁对\""},{"id":"cnc_p440_q4","topicId":"cnc_p440","difficulty":"standard","type":"choice","prompt":"这则短文出自哪里？","choices":[{"key":"A","text":"《列子》"},{"key":"B","text":"《论语》"},{"key":"C","text":"《孟子》"},{"key":"D","text":"《庄子》"}],"answer":"A","explanation":"两小儿辩日选自《列子·汤问》。《学弈》才选自《孟子》。","verify":"\"《列子》\""},{"id":"cnc_p441_q1","topicId":"cnc_p441","difficulty":"basic","type":"choice","prompt":"中心是「同学之间互相帮助」。哪一项材料该留下？","choices":[{"key":"A","text":"星期天我看了一场电影。"},{"key":"B","text":"我家的猫很胖。"},{"key":"C","text":"同桌把笔记借给我，并讲了那道题。"},{"key":"D","text":"昨天的风很大。"}],"answer":"C","explanation":"借笔记、讲题能表现互相帮助。电影、猫和风与这个中心无关。","verify":"\"同桌把笔记借给我，并讲了那道题。\""},{"id":"cnc_p441_q2","topicId":"cnc_p441","difficulty":"basic","type":"choice","prompt":"中心是「这次实验让我更细心」。哪一句跑题了？","choices":[{"key":"A","text":"我第一次把步骤看反了。"},{"key":"B","text":"第二次我对着清单做，才成功。"},{"key":"C","text":"我明白细心比赶时间重要。"},{"key":"D","text":"放学后我在操场踢了半小时球。"}],"answer":"D","explanation":"踢球和实验、细心没有关系。看错步骤和第二次成功都在写这个中心。","verify":"\"放学后我在操场踢了半小时球。\""},{"id":"cnc_p441_q3","topicId":"cnc_p441","difficulty":"standard","type":"choice","prompt":"材料太多时该怎样？","choices":[{"key":"A","text":"删掉不能表现中心的内容"},{"key":"B","text":"全部照单写上"},{"key":"C","text":"把中心改成每一件事"},{"key":"D","text":"只留一个和中心无关的例子"}],"answer":"A","explanation":"围绕中心选择，文章才集中。","verify":"\"删掉不能表现中心的内容\""},{"id":"cnc_p441_q4","topicId":"cnc_p441","difficulty":"standard","type":"choice","prompt":"哪一段是围绕一个中心选材的？","choices":[{"key":"A","text":"先写爸爸守时，再写我家的猫，最后写昨天的动画片。"},{"key":"B","text":"为了写「爸爸守时」，写他提前到车站，又写他从不迟到。"},{"key":"C","text":"守时。"},{"key":"D","text":"爸爸猫动画片。"}],"answer":"B","explanation":"提前到和从不迟到都在写守时。猫和动画片是另一些中心。","verify":"\"为了写「爸爸守时」，写他提前到车站，又写他从不迟到。\""},{"id":"cnc_p442_q1","topicId":"cnc_p442","difficulty":"basic","type":"choice","prompt":"哪一句更像认真写过的赠言？","choices":[{"key":"A","text":"前程似锦。"},{"key":"B","text":"万事如意。"},{"key":"C","text":"好好学习。"},{"key":"D","text":"你借我橡皮的那天，我才发现你总是先看见别人的难处。"}],"answer":"D","explanation":"带着那块橡皮的事，读的人知道你在说他。只剩四个字的祝愿太宽，谁都可以用。","verify":"\"你借我橡皮的那天，我才发现你总是先看见别人的难处。\""},{"id":"cnc_p442_q2","topicId":"cnc_p442","difficulty":"basic","type":"choice","prompt":"赠言最好不要怎样写？","choices":[{"key":"A","text":"抄一句和这个人毫无关系的空话"},{"key":"B","text":"写出他帮过你的一件小事"},{"key":"C","text":"写出你记住的一句话"},{"key":"D","text":"写出对他的祝愿，并说清为什么"}],"answer":"A","explanation":"空话不是不能写，但只有空话，就看不出是写给谁的。","verify":"\"抄一句和这个人毫无关系的空话\""},{"id":"cnc_p442_q3","topicId":"cnc_p442","difficulty":"standard","type":"choice","prompt":"写给老师的赠言，哪一种内容合适？","choices":[{"key":"A","text":"祝您以后不要再当老师。"},{"key":"B","text":"记得您把我叫到黑板前，耐心地重讲那道题。"},{"key":"C","text":"今天的天气不错。"},{"key":"D","text":"您的办公室在二楼。"}],"answer":"B","explanation":"重讲那道题，是你们之间的事。天气和楼层不是赠言。","verify":"\"记得您把我叫到黑板前，耐心地重讲那道题。\""},{"id":"cnc_p442_q4","topicId":"cnc_p442","difficulty":"standard","type":"choice","prompt":"「难忘小学生活」里的赠言，中心应当是什么？","choices":[{"key":"A","text":"把所有同学都批评一遍"},{"key":"B","text":"只写自己的家庭地址"},{"key":"C","text":"对这个人的感谢、祝福或记住的一件事"},{"key":"D","text":"抄一份课程表"}],"answer":"C","explanation":"赠言是说给具体的人听的。课程表和地址不是要说的话。","verify":"\"对这个人的感谢、祝福或记住的一件事\""},{"id":"cnc_p443_q1","topicId":"cnc_p443","difficulty":"basic","type":"choice","prompt":"《汤姆·索亚历险记》的作者是谁？","choices":[{"key":"A","text":"马克·吐温"},{"key":"B","text":"笛福"},{"key":"C","text":"托尔斯泰"},{"key":"D","text":"拉格洛芙"}],"answer":"A","explanation":"作者是马克·吐温。他也写过《威尼斯的小艇》。鲁滨逊的作者是笛福。","verify":"\"马克·吐温\""},{"id":"cnc_p443_q2","topicId":"cnc_p443","difficulty":"basic","type":"choice","prompt":"波莉姨妈让汤姆做什么？","choices":[{"key":"A","text":"去荒岛种麦子"},{"key":"B","text":"把篱笆刷白"},{"key":"C","text":"骑鹅旅行"},{"key":"D","text":"上台演戏"}],"answer":"B","explanation":"精彩片段里，汤姆本来为刷墙发愁。","verify":"\"把篱笆刷白\""},{"id":"cnc_p443_q3","topicId":"cnc_p443","difficulty":"standard","type":"choice","prompt":"汤姆怎样让别人抢着干活？","choices":[{"key":"A","text":"花钱雇他们"},{"key":"B","text":"把刷子藏起来"},{"key":"C","text":"做出刷墙非常有趣、不是谁都能干的样子"},{"key":"D","text":"告诉他们刷完可以不上学一年"}],"answer":"C","explanation":"他越是不让别人刷，别人越觉得这是难得的机会，还拿东西来换。","verify":"\"做出刷墙非常有趣、不是谁都能干的样子\""},{"id":"cnc_p443_q4","topicId":"cnc_p443","difficulty":"standard","type":"choice","prompt":"这个片段主要表现汤姆怎样？","choices":[{"key":"A","text":"很听姨妈的话，从不耍心眼"},{"key":"B","text":"不会和别人说话"},{"key":"C","text":"把篱笆拆掉了"},{"key":"D","text":"机灵，会把一件苦差变成让人羡慕的事"}],"answer":"D","explanation":"小伙伴一个接一个加入，汤姆自己反而坐在旁边。这就是他的机灵。","verify":"\"机灵，会把一件苦差变成让人羡慕的事\""},{"id":"cnc_p444_q1","topicId":"cnc_p444","difficulty":"basic","type":"choice","prompt":"「千锤万凿出深山」的下一句是哪一句？","choices":[{"key":"A","text":"粉骨碎身浑不怕"},{"key":"B","text":"烈火焚烧若等闲"},{"key":"C","text":"要留清白在人间"},{"key":"D","text":"千磨万击还坚劲"}],"answer":"B","explanation":"先写石灰被凿出深山，再写它不怕烈火。粉骨碎身是第三句。千磨万击是《竹石》。","verify":"\"烈火焚烧若等闲\""},{"id":"cnc_p444_q2","topicId":"cnc_p444","difficulty":"basic","type":"choice","prompt":"「粉骨碎身浑不怕」的下一句是哪一句？","choices":[{"key":"A","text":"粉身碎骨全不怕"},{"key":"B","text":"要留清白在人世"},{"key":"C","text":"要留清白在人间"},{"key":"D","text":"烈火焚烧若等闲"}],"answer":"C","explanation":"于谦写的是粉骨碎身、浑不怕。粉身碎骨、全不怕、在人世都是记混了。","verify":"\"要留清白在人间\""},{"id":"cnc_p444_q3","topicId":"cnc_p444","difficulty":"standard","type":"choice","prompt":"《石灰吟》的作者是谁？","choices":[{"key":"A","text":"郑燮"},{"key":"B","text":"王维"},{"key":"C","text":"王昌龄"},{"key":"D","text":"于谦"}],"answer":"D","explanation":"这首诗是于谦写的。《竹石》才是郑燮的。","verify":"\"于谦\""},{"id":"cnc_p444_q4","topicId":"cnc_p444","difficulty":"standard","type":"choice","prompt":"诗人借石灰说的是什么？","choices":[{"key":"A","text":"即便粉身碎骨，也要留下清白"},{"key":"B","text":"烧石灰的方法"},{"key":"C","text":"深山里的路很难走"},{"key":"D","text":"石灰应该卖个好价钱"}],"answer":"A","explanation":"锤、凿、焚烧都是考验。要留的是清白，不是价钱。","verify":"\"即便粉身碎骨，也要留下清白\""},{"id":"cnc_p445_q1","topicId":"cnc_p445","difficulty":"basic","type":"choice","prompt":"「咬定青山不放松」的下一句是哪一句？","choices":[{"key":"A","text":"立根原在破崖中"},{"key":"B","text":"立根原在岩石中"},{"key":"C","text":"立根原在破岩中"},{"key":"D","text":"千磨万击还坚劲"}],"answer":"C","explanation":"竹根长在破裂的岩石中。诗中是破岩，不是破崖。","verify":"\"立根原在破岩中\""},{"id":"cnc_p445_q2","topicId":"cnc_p445","difficulty":"basic","type":"choice","prompt":"「千磨万击还坚劲」的下一句是哪一句？","choices":[{"key":"A","text":"凭尔东西南北风"},{"key":"B","text":"任你东西南北风"},{"key":"C","text":"任尔东南西北风"},{"key":"D","text":"任尔东西南北风"}],"answer":"D","explanation":"任尔不能写成凭尔或任你。东西南北的顺序也不能颠倒。","verify":"\"任尔东西南北风\""},{"id":"cnc_p445_q3","topicId":"cnc_p445","difficulty":"standard","type":"choice","prompt":"《竹石》的作者是谁？","choices":[{"key":"A","text":"郑燮"},{"key":"B","text":"于谦"},{"key":"C","text":"杜甫"},{"key":"D","text":"苏轼"}],"answer":"A","explanation":"郑燮就是郑板桥。《石灰吟》是于谦的，两首咏物诗不要记成一个人。","verify":"\"郑燮\""},{"id":"cnc_p445_q4","topicId":"cnc_p445","difficulty":"standard","type":"choice","prompt":"哪一句不属于《竹石》？","choices":[{"key":"A","text":"咬定青山不放松"},{"key":"B","text":"粉骨碎身浑不怕"},{"key":"C","text":"立根原在破岩中"},{"key":"D","text":"任尔东西南北风"}],"answer":"B","explanation":"粉骨碎身浑不怕是《石灰吟》里的句子。","verify":"\"粉骨碎身浑不怕\""},{"id":"cnc_p446_q1","topicId":"cnc_p446","difficulty":"basic","type":"choice","prompt":"「茅檐长扫净无苔」的下一句是哪一句？","choices":[{"key":"A","text":"一水护田将绿绕"},{"key":"B","text":"花木成畦手自种"},{"key":"C","text":"两山排闼送青来"},{"key":"D","text":"花木成畦手自栽"}],"answer":"D","explanation":"院子扫干净了，花木是主人一畦一畦自己栽的。不是手自种。","verify":"\"花木成畦手自栽\""},{"id":"cnc_p446_q2","topicId":"cnc_p446","difficulty":"basic","type":"choice","prompt":"「一水护田将绿绕」的下一句是哪一句？","choices":[{"key":"A","text":"两山排闼送青来"},{"key":"B","text":"两山排闼送春来"},{"key":"C","text":"两山排闼送翠来"},{"key":"D","text":"茅檐长扫净无苔"}],"answer":"A","explanation":"两座山像推门一样把青翠送进来。不是送春，也不是送翠。","verify":"\"两山排闼送青来\""},{"id":"cnc_p446_q3","topicId":"cnc_p446","difficulty":"standard","type":"choice","prompt":"《书湖阴先生壁》的作者是谁？","choices":[{"key":"A","text":"于谦"},{"key":"B","text":"王安石"},{"key":"C","text":"郑燮"},{"key":"D","text":"王建"}],"answer":"B","explanation":"这首是王安石的。《石灰吟》是于谦的，《竹石》是郑燮的。","verify":"\"王安石\""},{"id":"cnc_p446_q4","topicId":"cnc_p446","difficulty":"standard","type":"choice","prompt":"「两山排闼送青来」里的「排闼」是什么意思？","choices":[{"key":"A","text":"把山推倒"},{"key":"B","text":"把田围起来"},{"key":"C","text":"推开门"},{"key":"D","text":"把花栽好"}],"answer":"C","explanation":"闼是门。排闼就是推门而入。山色像推开门送进来。","verify":"\"推开门\""}]
